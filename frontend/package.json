{
  "name": "jobseeker-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
